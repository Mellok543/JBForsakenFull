<root>
    <styles>
        <include src="s2r://panorama/styles/custom_game/jbf_menu.vcss_c" />
    </styles>

    <Panel class="jbf-ui-screen" hittest="false">
        <Panel id="jbf_menu_root" class="jbf-menu-window" hittest="false">
            <Panel class="jbf-menu-frame" hittest="false">
                <Panel class="jbf-menu-accent" hittest="false" />
                <Panel class="jbf-menu-accent-soft" hittest="false" />

                <Panel class="jbf-menu-content" hittest="false">
                    <Panel class="jbf-menu-brand" hittest="false">
                        <Label class="jbf-menu-brand-mark" text="JBF" />
                        <Panel class="jbf-menu-brand-line" hittest="false" />
                        <Label class="jbf-menu-brand-name" text="FORSAKEN" />
                    </Panel>

                    <Panel class="jbf-menu-header" hittest="false">
                        <Panel class="jbf-menu-title-wrap" hittest="false">
                            <Label id="jbf_menu_title" class="jbf-menu-title" text="{s:text}" />
                            <Label class="jbf-menu-subtitle" text="ВЫБЕРИТЕ ДЕЙСТВИЕ" />
                        </Panel>
                        <Panel class="jbf-menu-page-pill" hittest="false">
                            <Label id="jbf_menu_page" class="jbf-menu-page" text="{s:text}" />
                        </Panel>
                    </Panel>

                    <Panel class="jbf-menu-separator" hittest="false" />

                    <Panel class="jbf-menu-rows" hittest="false">
                        <Panel id="jbf_menu_row_0" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_0_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_1" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_1_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_2" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_2_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_3" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_3_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_4" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_4_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_5" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_5_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                        <Panel id="jbf_menu_row_6" class="jbf-menu-row">
                            <Panel class="jbf-menu-row-accent" hittest="false" />
                            <Label id="jbf_menu_row_6_text" class="jbf-menu-row-text" text="{s:text}" />
                            <Label class="jbf-menu-row-arrow" text="›" />
                        </Panel>
                    </Panel>

                    <Panel class="jbf-menu-separator footer" hittest="false" />

                    <Panel class="jbf-menu-footer" hittest="false">
                        <Panel class="jbf-menu-controls" hittest="false">
                            <Panel class="jbf-key"><Label text="W" /></Panel>
                            <Panel class="jbf-key"><Label text="S" /></Panel>
                            <Label class="jbf-key-caption" text="ВЫБОР" />
                            <Panel class="jbf-key action"><Label text="E" /></Panel>
                            <Label class="jbf-key-caption" text="ОТКРЫТЬ" />
                            <Panel class="jbf-key close"><Label text="R" /></Panel>
                            <Label class="jbf-key-caption" text="ЗАКРЫТЬ" />
                        </Panel>
                        <Label id="jbf_menu_status" class="jbf-menu-status" text="{s:text}" />
                    </Panel>
                </Panel>
            </Panel>
        </Panel>


        <Panel id="jbf_question_root" class="jbf-question" hittest="false">
            <Panel class="jbf-question-meta" hittest="false">
                <Label id="jbf_question_progress" class="jbf-question-progress" text="{s:text}" />
                <Panel class="jbf-question-meta-dot" hittest="false" />
                <Label id="jbf_question_timer" class="jbf-question-timer" text="{s:text}" />
            </Panel>
            <Label id="jbf_question_text" class="jbf-question-text" text="{s:text}" />
            <Panel class="jbf-question-underline" hittest="false" />
        </Panel>


        <Panel id="jbf_mapvote_root" class="jbf-mapvote" hittest="false">
            <Panel class="jbf-mapvote-header" hittest="false">
                <Panel class="jbf-mapvote-title-wrap" hittest="false">
                    <Label id="jbf_mapvote_title" class="jbf-mapvote-title" text="{s:text}" />
                    <Label class="jbf-mapvote-subtitle" text="ГОЛОСА В РЕАЛЬНОМ ВРЕМЕНИ" />
                </Panel>
                <Panel class="jbf-mapvote-timer-pill" hittest="false">
                    <Label id="jbf_mapvote_timer" class="jbf-mapvote-timer" text="{s:text}" />
                </Panel>
            </Panel>

            <Panel class="jbf-mapvote-separator" hittest="false" />

            <Panel class="jbf-mapvote-rows" hittest="false">
                <Panel id="jbf_mapvote_row_0" class="jbf-mapvote-row">
                    <Label id="jbf_mapvote_row_0_name" class="jbf-mapvote-name" text="{s:text}" />
                    <Panel class="jbf-mapvote-bar-track"><Panel id="jbf_mapvote_row_0_bar" class="jbf-mapvote-bar" /></Panel>
                    <Label id="jbf_mapvote_row_0_votes" class="jbf-mapvote-votes" text="{s:text}" />
                </Panel>
                <Panel id="jbf_mapvote_row_1" class="jbf-mapvote-row">
                    <Label id="jbf_mapvote_row_1_name" class="jbf-mapvote-name" text="{s:text}" />
                    <Panel class="jbf-mapvote-bar-track"><Panel id="jbf_mapvote_row_1_bar" class="jbf-mapvote-bar" /></Panel>
                    <Label id="jbf_mapvote_row_1_votes" class="jbf-mapvote-votes" text="{s:text}" />
                </Panel>
                <Panel id="jbf_mapvote_row_2" class="jbf-mapvote-row">
                    <Label id="jbf_mapvote_row_2_name" class="jbf-mapvote-name" text="{s:text}" />
                    <Panel class="jbf-mapvote-bar-track"><Panel id="jbf_mapvote_row_2_bar" class="jbf-mapvote-bar" /></Panel>
                    <Label id="jbf_mapvote_row_2_votes" class="jbf-mapvote-votes" text="{s:text}" />
                </Panel>
                <Panel id="jbf_mapvote_row_3" class="jbf-mapvote-row">
                    <Label id="jbf_mapvote_row_3_name" class="jbf-mapvote-name" text="{s:text}" />
                    <Panel class="jbf-mapvote-bar-track"><Panel id="jbf_mapvote_row_3_bar" class="jbf-mapvote-bar" /></Panel>
                    <Label id="jbf_mapvote_row_3_votes" class="jbf-mapvote-votes" text="{s:text}" />
                </Panel>
                <Panel id="jbf_mapvote_row_4" class="jbf-mapvote-row">
                    <Label id="jbf_mapvote_row_4_name" class="jbf-mapvote-name" text="{s:text}" />
                    <Panel class="jbf-mapvote-bar-track"><Panel id="jbf_mapvote_row_4_bar" class="jbf-mapvote-bar" /></Panel>
                    <Label id="jbf_mapvote_row_4_votes" class="jbf-mapvote-votes" text="{s:text}" />
                </Panel>
            </Panel>
        </Panel>


        <Panel id="jbf_mute_root" class="jbf-mute-status" hittest="false">
            <Panel class="jbf-mute-accent left" hittest="false" />
            <Label id="jbf_mute_text" class="jbf-mute-text" text="{s:text}" />
            <Panel class="jbf-mute-accent right" hittest="false" />
        </Panel>

        <Panel id="jbf_notify_root" class="jbf-notify" hittest="false">
            <Panel class="jbf-notify-accent" hittest="false" />
            <Label id="jbf_notify_text" class="jbf-notify-text" text="{s:text}" />
        </Panel>

        <Panel id="jbf_announce_root" class="jbf-announce" hittest="false">
            <Panel class="jbf-announce-line" hittest="false" />
            <Label id="jbf_announce_title" class="jbf-announce-title" text="{s:text}" />
            <Label id="jbf_announce_subtitle" class="jbf-announce-subtitle" text="{s:text}" />
        </Panel>

        <Panel id="jbf_round_root" class="jbf-round-status" hittest="false">
            <Label id="jbf_round_title" class="jbf-round-title" text="{s:text}" />
            <Panel class="jbf-round-dot" hittest="false" />
            <Label id="jbf_round_value" class="jbf-round-value" text="{s:text}" />
        </Panel>

        <Panel id="jbf_player_root" class="jbf-player-status" hittest="false">
            <Label id="jbf_player_primary" class="jbf-player-primary" text="{s:text}" />
            <Label id="jbf_player_secondary" class="jbf-player-secondary" text="{s:text}" />
        </Panel>

        <Panel id="jbf_event_root" class="jbf-event-banner" hittest="false">
            <Label id="jbf_event_title" class="jbf-event-title" text="{s:text}" />
            <Label id="jbf_event_value" class="jbf-event-value" text="{s:text}" />
        </Panel>
    </Panel>
</root>
